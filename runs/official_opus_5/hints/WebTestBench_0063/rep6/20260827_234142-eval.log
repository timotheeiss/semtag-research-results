ries.item.{key}[.{control}]\",\"item\":{\"role\":\"navigation\",\"target\":\"home.categories\"},\"fields\":[\"key\",\"name\"],\"items\":[[\"craft\",\"传统工艺\"],[\"performance\",\"传统表演\"],[\"folk\",\"民俗活动\"],[\"art\",\"传统美术\"]]},{\"id\":\"footer.links\",\"idPattern\":\"footer.links.item.{key}[.{control}]\",\"item\":{\"role\":\"navigation\"},\"fields\":[\"key\",\"name\"],\"items\":[[\"about\",\"关于我们\"],[\"guide\",\"使用指南\"],[\"contact\",\"联系方式\"],[\"copyright\",\"版权声明\"]]}]}"
