\\n  for (const cl of [\\'cl2\\',\\'cl3\\',\\'cl4\\',\\'cl5\\']) {\\n    const h = document.querySelector(`[data-semtag-id=\\'checklists.grid.item.${cl}\\']`);\\n    if (h.getAttribute(\\'data-semtag-state\\')===\\'closed\\') h.click();\\n    await new Promise(r=>setTimeout(r,300));\\n    out[cl] = [...document.querySelectorAll(`[data-semtag-id^=\\'checklists.tasks.${cl}.item.\\']`)].map(e=>(e.closest(\\'li,div[class*=flex]\\')||e.parentElement).innerText.replace(/\\\\n+/g,\\' :: \\'));\\n  }\\n  return out;\\n}');\n```"
