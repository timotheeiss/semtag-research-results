Reception Details\\',\\'Wedding Attire\\',\\'Honeymoon Planning\\'];\\n  for (const t of titles) {\\n    const h = Array.from(document.querySelectorAll(\\'h3\\')).find(x=>x.textContent.trim()===t);\\n    let card = h; while (card && !card.innerText.includes(\\'Save to Dashboard\\')) card = card.parentElement;\\n    if (!card.innerText.includes(\\'Progress\\') || !card.querySelector(\\'[class*=\"check\"], input\\')) { h.click(); await new Promise(r=>setTimeout(r,300)); }\\n    // re-find card\\n    const h2 = Array.from(document.querySelectorAll(\\'h3\\')).find(x=>x.textContent.trim()===t);\\n    let c2 = h2; while (c2 && !c2.innerText.includes(\\'Save to Dashboard\\')) c2 = c2.parentElement;\\n    const declared = c2.innerText.match(/(\\\\d+) tasks/)?.[1];\\n    // tasks appear between Progress% and Save to Dashboard\\n    const lines = c2.innerText.split(\\'\\\\n\\').map(s=>s.trim()).filter(Boolean);\\n    const startIdx = lines.findIndex(l=>/^\\\\d+%$/.test(l));\\n    const endIdx = lines.indexOf(\\'Save to Dashboard\\');\\n    const taskLines = lines.slice(startIdx+1, endIdx);\\n    out[t] = {declared, taskLines: taskLines.length, sample: taskLines.slice(0,4)};\\n  }\\n  return out;\\n}');\n```"
