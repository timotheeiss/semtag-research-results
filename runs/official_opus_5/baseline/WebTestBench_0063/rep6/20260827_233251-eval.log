  - combobox [ref=e294] [cursor=pointer]:\n              - generic: 全部类别\n              - img [ref=e295]\n            - combobox [ref=e297] [cursor=pointer]:\n              - generic: 全部地区\n              - img [ref=e298]\n            - combobox [ref=e300] [cursor=pointer]:\n              - generic: 按名称\n              - img [ref=e301]\n          - paragraph [ref=e303]: 共 8 个非遗项目\n          - generic [ref=e304]:\n            - generic [ref=e305]:\n              - generic [ref=e306]:\n                - img \"春节\" [ref=e307]\n                - generic [ref=e309]: 民俗活动\n                - generic [ref=e310]:\n                  - heading \"春节\" [level=3] [ref=e311]\n                  - paragraph [ref=e312]: Spring Festival\n              - generic [ref=e313]:\n                - generic [ref=e314]:\n                  - img [ref=e315]\n                  - generic [ref=e318]: 北京 · 华夏大地\n                - paragraph [ref=e319]: 春节是中国最重要的传统节日，承载着团圆、祈福、辞旧迎新等丰富的文化内涵。\n                - link \"了解详情\" [ref=e320] [cursor=pointer]:\n                  - /url: /heritage/spring-festival\n                  - text: 了解详情\n                  - img [ref=e321]\n            - generic [ref=e323]:\n              - generic [ref=e324]:\n                - img \"端午龙舟\" [ref=e325]\n                - generic [ref=e327]: 民俗活动\n                - generic [ref=e328]:\n                  - heading \"端午龙舟\" [level=3] [ref=e329]\n                  - paragraph [ref=e330]: Dragon Boat Racing\n              - generic [ref=e331]:\n                - generic [ref=e332]:\n                  - img [ref=e333]\n                  - generic [ref=e336]: 广东 · 楚地遗风\n                - paragraph [ref=e337]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e338] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e339]\n            - generic [ref=e341]:\n              - generic [ref=e342]:\n                - img \"剪纸\" [ref=e343]\n                - generic [ref=e345]: 传统美术\n                - generic [ref=e346]:\n                  - heading \"剪纸\" [level=3] [ref=e347]\n                  - paragraph [ref=e348]: Paper Cutting\n              - generic [ref=e349]:\n                - generic [ref=e350]:\n                  - img [ref=e351]\n                  - generic [ref=e354]: 陕西 · 黄土高原\n                - paragraph [ref=e355]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e356] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e357]\n            - generic [ref=e359]:\n              - generic [ref=e360]:\n                - img \"京剧\" [ref=e361]\n                - generic [ref=e363]: 传统表演\n                - generic [ref=e364]:\n                  - heading \"京剧\" [level=3] [ref=e365]\n                  - paragraph [ref=e366]: Peking Opera\n              - generic [ref=e367]:\n                - generic [ref=e368]:\n                  - img [ref=e369]\n                  - generic [ref=e372]: 北京 · 京城古韵\n                - paragraph [ref=e373]: 京剧是中国影响最大的戏曲剧种，被誉为\"国粹\"，以唱念做打的表演方式闻名于世。\n                - link \"了解详情\" [ref=e374] [cursor=pointer]:\n                  - /url: /heritage/peking-opera\n                  - text: 了解详情\n                  - img [ref=e375]\n            - generic [ref=e377]:\n              - generic [ref=e378]:\n                - img \"昆曲\" [ref=e379]\n                - generic [ref=e381]: 传统表演\n                - generic [ref=e382]:\n                  - heading \"昆曲\" [level=3] [ref=e383]\n                  - paragraph [ref=e384]: Kunqu Opera\n              - generic [ref=e385]:\n                - generic [ref=e386]:\n                  - img [ref=e387]\n                  - generic [ref=e390]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e391]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e392] [cursor=pointer]:\n                  - /url: /heritage/kunqu-opera\n                  - text: 了解详情\n                  - img [ref=e393]\n            - generic [ref=e395]:\n              - generic [ref=e396]:\n                - img \"书法\" [ref=e397]\n                - generic [ref=e399]: 传统美术\n                - generic [ref=e400]:\n                  - heading \"书法\" [level=3] [ref=e401]\n                  - paragraph [ref=e402]: Chinese Calligraphy\n              - generic [ref=e403]:\n                - generic [ref=e404]:\n                  - img [ref=e405]\n                  - generic [ref=e408]: 安徽 · 神州墨韵\n                - paragraph [ref=e409]: 书法是中国特有的艺术形式，以毛笔书写汉字，融合了文字、绘画与哲学的精髓。\n                - link \"了解详情\" [ref=e410] [cursor=pointer]:\n                  - /url: /heritage/chinese-calligraphy\n                  - text: 了解详情\n                  - img [ref=e411]\n            - generic [ref=e413]:\n              - generic [ref=e414]:\n                - img \"苏绣\" [ref=e415]\n                - generic [ref=e417]: 传统工艺\n                - generic [ref=e418]:\n                  - heading \"苏绣\" [level=3] [ref=e419]\n                  - paragraph [ref=e420]: Suzhou Embroidery\n              - generic [ref=e421]:\n                - generic [ref=e422]:\n                  - img [ref=e423]\n                  - generic [ref=e426]: 江苏 · 江南水乡\n                - paragraph [ref=e427]: 苏绣是中国四大名绣之一，以精细雅洁著称，图案秀丽、针法活泼、色彩清雅。\n                - link \"了解详情\" [ref=e428] [cursor=pointer]:\n                  - /url: /heritage/suzhou-embroidery\n                  - text: 了解详情\n                  - img [ref=e429]\n            - generic [ref=e431]:\n              - generic [ref=e432]:\n                - img \"宜兴紫砂\" [ref=e433]\n                - generic [ref=e435]: 传统工艺\n                - generic [ref=e436]:\n                  - heading \"宜兴紫砂\" [level=3] [ref=e437]\n                  - paragraph [ref=e438]: Yixing Purple Clay\n              - generic [ref=e439]:\n                - generic [ref=e440]:\n                  - img [ref=e44