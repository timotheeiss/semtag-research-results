length === 0) continue;\\n    \\n    // Find images in this card\\n    const images = card.querySelectorAll(\\'img\\');\\n    const imageData = Array.from(images).map(img => ({\\n      alt: img.getAttribute(\\'alt\\') || img.getAttribute(\\'title\\') || \\'No alt text\\',\\n      src: img.getAttribute(\\'src\\') || \\'No src\\'\\n    }));\\n    \\n    // Check if main card image alt matches the item name\\n    if (imageData.length > 0) {\\n      const mainImageAlt = imageData[0].alt;\\n      const altMatchesTitle = mainImageAlt.includes(title) || title.includes(mainImageAlt.split(\\' \\')[0]);\\n      \\n      items.push({\\n        title: title,\\n        hasImages: imageData.length > 0,\\n        mainImageAlt: mainImageAlt,\\n        altMatchesTitle: altMatchesTitle,\\n        totalImages: imageData.length\\n      });\\n    }\\n  }\\n  \\n  // Filter out non-heritage items (华夏非遗, etc)\\n  const heritageItems = items.filter(item => item.title.length > 0 && [\\'春节\\', \\'端午龙舟\\', \\'剪纸\\', \\'京剧\\', \\'昆曲\\', \\'书法\\', \\'苏绣\\', \\'宜兴紫砂\\'].includes(item.title));\\n  \\n  return {\\n    totalHeritageItems: heritageItems.length,\\n    allHaveImages: heritageItems.every(item => item.hasImages),\\n    altTextMatches: heritageItems.filter(item => item.altMatchesTitle).length,\\n    items: heritageItems\\n  };\\n}');\n```"
