 paragraph [ref=e147]: Kunqu Opera\n              - generic [ref=e148]:\n                - generic [ref=e149]:\n                  - img [ref=e150]\n                  - generic [ref=e153]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e154]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e155] [cursor=pointer]:\n                  - /url: /heritage/kunqu-opera\n                  - text: 了解详情\n                  - img [ref=e156]\n            - generic [ref=e158]:\n              - generic [ref=e159]:\n                - img \"书法\" [ref=e160]\n                - generic [ref=e162]: 传统美术\n                - generic [ref=e163]:\n                  - heading \"书法\" [level=3] [ref=e164]\n                  - paragraph [ref=e165]: Chinese Calligraphy\n              - generic [ref=e166]:\n                - generic [ref=e167]:\n                  - img [ref=e168]\n                  - generic [ref=e171]: 安徽 · 神州墨韵\n                - paragraph [ref=e172]: 书法是中国特有的艺术形式，以毛笔书写汉字，融合了文字、绘画与哲学的精髓。\n                - link \"了解详情\" [ref=e173] [cursor=pointer]:\n                  - /url: /heritage/chinese-calligraphy\n                  - text: 了解详情\n                  - img [ref=e174]\n            - generic [ref=e176]:\n              - generic [ref=e177]:\n                - img \"苏绣\" [ref=e178]\n                - generic [ref=e180]: 传统工艺\n                - generic [ref=e181]:\n                  - heading \"苏绣\" [level=3] [ref=e182]\n                  - paragraph [ref=e183]: Suzhou Embroidery\n              - generic [ref=e184]:\n                - generic [ref=e185]:\n                  - img [ref=e186]\n                  - generic [ref=e189]: 江苏 · 江南水乡\n                - paragraph [ref=e190]: 苏绣是中国四大名绣之一，以精细雅洁著称，图案秀丽、针法活泼、色彩清雅。\n                - link \"了解详情\" [ref=e191] [cursor=pointer]:\n                  - /url: /heritage/suzhou-embroidery\n                  - text: 了解详情\n                  - img [ref=e192]\n            - generic [ref=e194]:\n              - generic