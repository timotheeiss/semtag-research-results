ric [ref=e278]: 广东 · 楚地遗风\n                - paragraph [ref=e279]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e280] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e281]\n            - generic [ref=e283]:\n              - generic [ref=e284]:\n                - img \"剪纸\" [ref=e285]\n                - generic [ref=e287]: 传统美术\n                - generic [ref=e288]:\n                  - heading \"剪纸\" [level=3] [ref=e289]\n                  - paragraph [ref=e290]: Paper Cutting\n              - generic [ref=e291]:\n                - generic [ref=e292]:\n                  - img [ref=e293]\n                  - generic [ref=e296]: 陕西 · 黄土高原\n                - paragraph [ref=e297]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e298] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e299]\n            - generic [ref=e301]:\n              - generic [ref=e302]:\n                - img \"京剧\" [ref=e303]\n                - generic [ref=e305]: 传统表演\n                - generic [ref=e306]:\n                  - heading \"京剧\" [level=3] [ref=e307]\n                  - paragraph [ref=e308]: Peking Opera\n              - generic [ref=e309]:\n                - generic [ref=e310]:\n                  - img [ref=e311]\n                  - generic [ref=e314]: 北京 · 京城古韵\n                - paragraph [ref=e315]: 京剧是中国影响最大的戏曲剧种，被誉为\"国粹\"，以唱念做打的表演方式闻名于世。\n                - link \"了解详情\" [ref=e316] [cursor=pointer]:\n                  - /url: /heritage/peking-opera\n                  - text: 了解详情\n                  - img [ref=e317]\n            - generic [ref=e319]:\n              - generic [ref=e320]:\n                - img \"昆曲\" [ref=e321]\n                - generic [ref=e323]: 传统表演\n                - generic [ref=e324]:\n                  - heading \"昆曲\" [level=3] [ref=e325]\n                  - paragraph [ref=e326]: Kunqu Opera\n              - generic [ref=e327]:\n                - generic [ref=e328]:\n                  - img [ref=e329]\n                  - generic [ref=e332]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e333]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e334] [cursor=pointer]:\n                  - /url: /heritage/kunqu-opera\n                  - text: 了解详情\n                  - img [ref=e335]\n            - generic [ref=e337]:\n              - generic [ref=e338]:\n                - img \"书法\" [ref=e339]\n                - generic [ref=e341]: 传统美术\n                - generic [ref=e342]:\n                  - heading \"书法\" [level=3] [ref=e343]\n                  - paragraph [ref=e344]: Chinese Calligraphy\n              - generic [ref=e345]:\n                - generic [ref=e346]:\n                  - img [ref=e347]\n                  - generic [ref=e350]: 安徽 · 神州墨韵\n                - paragraph [ref=e351]: 书法是中国特有的艺术形式，以毛笔书写汉字，融合了文字、绘画与哲学的精髓。\n                - link \"了解详情\" [ref=e352] [cursor=pointer]:\n                  - /url: /heritage/chinese-calligraphy\n                  - text: 了解详情\n                  - img [ref=e353]\n            - generic [ref=e176]:\n              - generic [ref=e177]:\n                - img \"苏绣\" [ref=e178]\n                - generic [ref=e180]: 传统工艺\n                - generic [ref=e181]:\n                  - heading \"苏绣\" [level=3] [ref=e182]\n                  - paragraph [ref=e183]: Suzhou Embroidery\n              - generic [ref=e184]:\n                - generic [ref=e185]:\n                  - img [ref=e186]\n                  - generic [ref=e189]: 江苏 · 江南水乡\n                - paragraph [ref=e190]: 苏绣是中国四大名绣之一，以精细雅洁著称，图案秀丽、针法活泼、色彩清雅。\n                - link \"了解详情\" [ref=e191] [cursor=pointer]:\n                  - /url: /heritage/suzhou-embroidery\n                  - text: 了解详情\n                  - img [ref=e192]\n            - generic [ref=e355]:\n              - generic [ref=e356]:\n                - img \"宜兴紫砂\" [ref=e357]\n                - generic [ref=e359]: 传统工艺\n                - generic [ref=e360]:\n                  - heading \"宜兴紫砂\" [level=3] [ref=e361]\n                  - paragraph [ref=e362]: Yixing Purple Clay\n              - generic [ref=e363]:\n                - generic [ref=e364]:\n                  - img [ref=e365]\n                  - generic [ref=e368]: 江苏 · 太湖之滨\n                - paragraph [ref=e369]: 宜兴紫砂壶以独特的紫砂泥料制成，造型古朴典雅，是中国传统茶文化的重要载体。\n                - link \"了解详情\" [ref=e370] [cursor=pointer]:\n                  - /url: /heritage/yixing-teapot\n                  - text: 了解详情\n                  - img [ref=e371]\n    - contentinfo [ref=e212]:\n      - generic [ref=e213]:\n        - generic [ref=e214]:\n          - generic [ref=e215]:\n            - generic [ref=e216]:\n              - generic [ref=e218]: 遗\n              - heading \"华夏非遗\" [level=3] [ref=e220]\n            - paragraph [ref=e221]: 致力于保护和传承中国非物质文化遗产，让千年文化在数字时代焕发新的生机。\n          - generic [ref=e222]:\n            - heading \"探索分类\" [level=4] [ref=e223]\n            - list [ref=e224]:\n              - listitem [ref=e225]:\n                - link \"传统工艺\" [ref=e226] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e227]:\n                - link \"传统表演\" [ref=e228] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e229]:\n                - link \"民俗活动\" [ref=e230] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e231]:\n                - link \"传统美术\" [ref=e232] [cursor=pointer]:\n                  - /url: \"#categories\"\n          - generic [ref=e233]:\n            - heading \"了解更多\" [level=4] [ref=e234]\n            - list [ref=e235]:\n              - listitem [ref=e236]:\n                - link \"关于我们\" [ref=e237] [cursor=pointer]:\n                  - /url: \"#\"\n              - listitem [ref=e238]:\n                - link \"使用指南\" [ref=e239] [cursor=pointer]:\n                  - /url: \"#\"\n              - listitem [ref=e240]:\n                - link \"联系方式\" [ref=e241] [cursor=pointer]:\n                  - /url: \"#\"\n              - listitem [ref=e242]:\n                - link \"版权声明\" [ref=e243] [cursor=pointer]:\n                  - /url: \"#\"\n        - paragraph [ref=e245]: © 2024 华夏非遗. 保护传承，让文化永续流传。\n```"
      }
