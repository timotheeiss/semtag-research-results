n.\"}, {\"item_id\": \"FT-6\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Industry filter (Technology → 2 jobs), Location filter (New York, NY → 1 job), Job Type filter (Part-time → 1 job) all correctly filtered the results.\"}, {\"item_id\": \"FT-7\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Typing \\\"Python\\\" in the search box filtered results to the Data Analyst job (which has Python as a skill tag), showing \\\"Showing 1 jobs\\\".\"}, {\"item_id\": \"FT-8\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Filled Full Name, Email, Cover Letter/Message fields on job-5 details page and clicked Submit Application; got success toast \\\"Application submitted! Your application for Data Analyst at FinanceFirst has been sent.\\\"\"}, {\"item_id\": \"CS-9\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Submitting empty form kept form on page and focused the required Full Name field (no submission). Submitting with invalid email \\\"not-an-email\\\" also blocked submission and focused the Email field. Only after correcting the email did submission succeed.\"}, {\"item_id\": \"CS-10\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Submitting the Post Job form with all fields empty did not create a listing; native browser validation messages \\\"Please fill out this field.\\\" appeared on Job Title, Min Salary, Max Salary, and Job Description fields, blocking submission.\"}, {\"item_id\": \"CS-11\", \"verdict\": \"FAIL\", \"issue\": \"Duplicate application not blocked\", \"actual\": \"Submitted a second application to the same job (job-5) using the identical email address (test.user@example.com) as a prior successful application. The system accepted it and displayed the same success toast \\\"Application submitted!\\\" with no warning or rejection of the duplicate.\", \"evidence\": null}, {\"item_id\": \"CS-12\", \"verdict\": 