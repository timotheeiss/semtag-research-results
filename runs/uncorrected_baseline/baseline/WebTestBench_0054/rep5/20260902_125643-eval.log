   \"2024-01-07\"\n    ],\n    \"invalid\": [\n      \"2024-01-07\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"database-schema\",\n    \"relIds\": [\n      \"data-migrations\",\n      \"query-optimization\",\n      \"2024-01-13\"\n    ],\n    \"invalid\": [\n      \"2024-01-13\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"data-migrations\",\n    \"relIds\": [\n      \"database-schema\",\n      \"2024-01-06\"\n    ],\n    \"invalid\": [\n      \"2024-01-06\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"query-optimization\",\n    \"relIds\": [\n      \"database-schema\",\n      \"redis-caching\",\n      \"2024-01-04\"\n    ],\n    \"invalid\": [\n      \"2024-01-04\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"redis-caching\",\n    \"relIds\": [\n      \"session-management\",\n      \"query-optimization\",\n      \"2024-01-03\"\n    ],\n    \"invalid\": [\n      \"2024-01-03\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"component-library\",\n    \"relIds\": [\n      \"design-tokens\",\n      \"accessibility-standards\",\n      \"2024-01-14\"\n    ],\n    \"invalid\": [\n      \"2024-01-14\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"design-tokens\",\n    \"relIds\": [\n      \"component-library\",\n      \"2024-01-12\"\n    ],\n    \"invalid\": [\n      \"2024-01-12\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"accessibility-standards\",\n    \"relIds\": [\n      \"component-library\",\n      \"2024-01-10\"\n    ],\n    \"invalid\": [\n      \"2024-01-10\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"api-key-management\",\n    \"relIds\": [\n      \"rate-limiting\",\n      \"2024-01-08\"\n    ],\n    \"invalid\": [\n      \"2024-01-08\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"logging-standards\",\n    \"relIds\": [\n      \"monitoring-alerts\",\n      \"2024-01-07\"\n    ],\n    \"invalid\": [\n      \"2024-01-07\"\n    ],\n    \"selfRef\": false\n  },\n  {\n    \"id\": \"monitoring-alerts\",\n    \"relIds\": [\n      \"logging-standards\",\n      \"2024-01-05\",\n      \"api\"\n    ],\n    \"invalid\": [\n      \"2024-01-05\",\n      \"api\"\n    ],\n    \"selfRef\": false\n  }\n]\n### Ran Playwright code\n```js\nawait page.evaluate('async () => {\\n  const res = await fetch(\\'/src/data/documents.ts\\');\\n  const text = await res.text();\\n  const topIds = [...text.matchAll(/id:\\\\s*\\'([a-zA-Z0-9\\\\-_]+)\\',\\\\s*\\\\n\\\\s*title:/g)].map(m=>m[1]);\\n  const topIdSet = new Set(topIds);\\n  // split into document blocks\\n  const docBlocks = text.split(/\\\\n    \\\\{\\\\n        id: \\'/).slice(1);\\n  const issues = [];\\n  for (const block of docBlocks) {\\n    const id = block.split(\"\\'\")[0];\\n    const relIdx = block.indexOf(\\'relatedDocs:\\');\\n    const relSection = block.slice(relIdx, relIdx+400);\\n    const relIds = [...relSection.matchAll(/\\'([a-zA-Z0-9\\\\-_]+)\\'/g)].map(m=>m[1]);\\n    const invalid = relIds.filter(r => !topIdSet.has(r));\\n    const selfRef = relIds.includes(id);\\n    issues.push({ id, relIds, invalid, selfRef });\\n  }\\n  return issues;\\n}');\n```"
