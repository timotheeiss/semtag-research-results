tle}</h3>\\n        <ChevronDown\\n          size={18}\\n          className={cn(\\n            'text-muted-foreground transition-transform duration-300',\\n            isExpanded && 'rotate-180'\\n          )}\\n        />\\n      </button>\\n      \\n      <AnimatePresence initial={false}>\\n        {isExpanded && (\\n          <motion.div\\n            initial={{ height: 0, opacity: 0 }}\\n            animate={{ height: 'auto', opacity: 1 }}\\n            exit={{ height: 0, opacity: 0 }}\\n            transition={{ duration: 0.3, ease: 'easeInOut' }}\\n          >\\n            <div ref={contentRef} className=\\\"px-4 pb-4\\\">\\n              <p className=\\\"text-sm text-muted-foreground leading-relaxed mb-4\\\">\\n                {section.content}\\n              </p>\\n              \\n              {section.links && section.links.length > 0 && (\\n                <div className=\\\"flex flex-wrap gap-2 pt-2 border-t border-border\\\">\\n                  {section.links.map((link) => (\\n                    <button\\n                      key={link.docId}\\n                      onClick={(e) => handleLinkClick(link.docId, e)}\\n                      className=\\\"inline-flex items-center gap-1.5 text-xs px-2.5 py-1.5 rounded-md bg-primary/10 text-primary hover:bg-primary/20 transition-colors\\\"\\n                    >\\n                      <LinkIcon size={12} />\\n                      {link.text}\\n                    </button>\\n                  ))}\\n                </div>\\n              )}\\n            </div>\\n          </motion.div>\\n        )}\\n      </AnimatePresence>\\n\\n      {!isExpanded && section.links && section.links.length > 0 && (\\n        <div className=\\\"px-4 pb-3 flex flex-wrap gap-2\\\">\\n          {section.links.map((link) => (\\n            <button\\n              key={link.docId}\\n              onClick={(e) => handleLinkClick(link.docId, e)}\\n              className=\\\"inline-flex items-center gap-1.5 text-xs px-2.5 py-1.5 rounded-md bg-secondary text-muted-foreground cursor-not-allowed opacity-60\\\"\\n              title=\\\"Expand section to access link\\\"\\n            >\\n              <LinkIcon size={12} />\\n              {link.text}\\n            </button>\\n          ))}\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\"\n### Ran Playwright code\n```js\nawait page.evaluate('async () => {\\n  const res = await fetch(\\'/src/components/DocumentSection.tsx\\');\\n  const text = await res.text();\\n  const idx = text.indexOf(\\'sourceMappingURL\\');\\n  const b64 = text.slice(idx + \\'sourceMappingURL=data:application/json;base64,\\'.length);\\n  const decoded = atob(b64.trim());\\n  const json = JSON.parse(decoded);\\n  return json.sourcesContent[0];\\n}');\n```"
