             exit={{ opacity: 0 }}\\n              transition={{ duration: 0.3 }}\\n            >\\n              <HeroSection />\\n              <HeritageListing />\\n            </motion.div>\\n          )}\\n        </AnimatePresence>\\n      </main>\\n      \\n      <Footer />\\n    </div>\\n  );\\n};\\n\\nexport default Index;\\n\"\n### Ran Playwright code\n```js\nawait page.evaluate('async () => {\\n  const res = await fetch(\\'/src/pages/Index.tsx\\');\\n  const text = await res.text();\\n  const marker = \\'sourceMappingURL=data:application/json;base64,\\';\\n  const idx = text.indexOf(marker);\\n  const b64 = text.slice(idx + marker.length).trim();\\n  const json = JSON.parse(atob(b64));\\n  return json.sourcesContent[0];\\n}');\n```"
