        "text": "{\"recorded_count\": 19, \"total_count\": 19, \"missing_ids\": [], \"complete\": true, \"results\": [{\"item_id\": \"FT-1\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Posted \\\"QA Automation Engineer\\\" job with title/industry/type/location/salary/description/skill; it appeared in Employer Dashboard (Active Jobs 5→6) and in job-seeker listing (8→9 jobs) with matching details.\"}, {\"item_id\": \"FT-2\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Clicking delete opened an alertdialog \\\"Delete this job?\\\"; Cancel preserved the job; confirming Delete removed \\\"Product Designer\\\" from dashboard (Active Jobs 5→4, Total Applications 5→4) and from job-seeker listing.\"}, {\"item_id\": \"FT-3\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Dashboard listed only the current employer's jobs (5 of the 8 seed jobs, since 3 belong to other companies); Active Jobs and Total Applications counts matched the sum of per-job application counts at every step of testing.\"}, {\"item_id\": \"FT-4\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Clicking the applications toggle on \\\"Senior Frontend Developer\\\" expanded a list showing each applicant's name, email, message, and date.\"}, {\"item_id\": \"FT-5\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Home page showed \\\"Showing 8 jobs\\\" matching the 8 listed cards; clicking a card navigated to /jobs/job-1 with full detail view.\"}, {\"item_id\": \"FT-6\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Industry=Technology alone → 3 jobs; combined with Location=Remote → 1 job; combined further with Type=Part-time → 0 jobs (no-results state shown); Clear filters restored all 9 jobs.\"}, {\"item_id\": \"FT-7\", \"verdict\": \"PASS\", \"issue\": null, \"actual\": null, \"evidence\": \"Search \\\"REACT\\\" (uppercase) matched job-1 via