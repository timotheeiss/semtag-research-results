96]:\n              - paragraph [ref=e1097]: \"34\"\n              - paragraph [ref=e1098]: 省市覆盖\n            - generic [ref=e1099]:\n              - paragraph [ref=e1100]: 10+\n              - paragraph [ref=e1101]: 门类分类\n        - generic [ref=e1106]:\n          - generic [ref=e1107]:\n            - heading \"非遗项目\" [level=2] [ref=e1108]\n            - paragraph [ref=e1109]: 探索中国丰富多彩的非物质文化遗产，感受千年传承的文化魅力\n          - generic [ref=e1110]:\n            - textbox \"搜索非遗项目...\" [ref=e1112]\n            - combobox [ref=e1113] [cursor=pointer]:\n              - generic: 全部类别\n              - img [ref=e1114]\n            - combobox [ref=e1116] [cursor=pointer]:\n              - generic: 全部地区\n              - img [ref=e1117]\n            - combobox [ref=e1119] [cursor=pointer]:\n              - generic: 按年份\n              - img [ref=e1120]\n          - paragraph [ref=e1122]: 共 8 个非遗项目\n          - generic [ref=e1123]:\n            - generic [ref=e1124]:\n              - generic [ref=e1125]:\n                - img \"昆曲\" [ref=e1126]\n                - generic [ref=e1128]: 传统表演\n                - generic [ref=e1129]:\n                  - heading \"昆曲\" [level=3] [ref=e1130]\n                  - paragraph [ref=e1131]: Kunqu Opera\n              - generic [ref=e1132]:\n                - generic [ref=e1133]:\n                  - img [ref=e1134]\n                  - generic [ref=e1137]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e1138]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e1139] [cursor=pointer]:\n                  - /url: /heritage/kunqu-opera\n                  - text: 了解详情\n                  - img [ref=e1140]\n            - generic [ref=e1142]:\n              - generic [ref=e1143]:\n                - img \"苏绣\" [ref=e1144]\n                - generic [ref=e1146]: 传统工艺\n                - generic [ref=e1147]:\n                  - heading \"苏绣\" [level=3] [ref=e1148]\n                  - paragraph [ref=e1149]: Suzhou Embroidery\n              - generic [ref=e1150]:\n                - generic [ref=e1151]:\n                  - img [ref=e1152]\n                  - generic [ref=e1155]: 江苏 · 江南水乡\n                - paragraph [ref=e1156]: 苏绣是中国四大名绣之一，以精细雅洁著称，图案秀丽、针法活泼、色彩清雅。\n                - link \"了解详情\" [ref=e1157] [cursor=pointer]:\n                  - /url: /heritage/suzhou-embroidery\n                  - text: 了解详情\n                  - img [ref=e1158]\n            - generic [ref=e1160]:\n              - generic [ref=e1161]:\n                - img \"宜兴紫砂\" [ref=e1162]\n                - generic [ref=e1164]: 传统工艺\n                - generic [ref=e1165]:\n                  - heading \"宜兴紫砂\" [level=3] [ref=e1166]\n                  - paragraph [ref=e1167]: Yixing Purple Clay\n              - generic [ref=e1168]:\n                - generic [ref=e1169]:\n                  - img [ref=e1170]\n                  - generic [ref=e1173]: 江苏 · 太湖之滨\n                - paragraph [ref=e1174]: 宜兴紫砂壶以独特的紫砂泥料制成，造型古朴典雅，是中国传统茶文化的重要载体。\n                - link \"了解详情\" [ref=e1175] [cursor=pointer]:\n                  - /url: /heritage/yixing-teapot\n                  - text: 了解详情\n                  - img [ref=e1176]\n            - generic [ref=e1178]:\n              - generic [ref=e1179]:\n                - img \"春节\" [ref=e1180]\n                - generic [ref=e1182]: 民俗活动\n                - generic [ref=e1183]:\n                  - heading \"春节\" [level=3] [ref=e1184]\n                  - paragraph [ref=e1185]: Spring Festival\n              - generic [ref=e1186]:\n                - generic [ref=e1187]:\n                  - img [ref=e1188]\n                  - generic [ref=e1191]: 北京 · 华夏大地\n                - paragraph [ref=e1192]: 春节是中国最重要的传统节日，承载着团圆、祈福、辞旧迎新等丰富的文化内涵。\n                - link \"了解详情\" [ref=e1193] [cursor=pointer]:\n                  - /url: /heritage/spring-festival\n                  - text: 了解详情\n                  - img [ref=e1194]\n            - generic [ref=e1196]:\n              - generic [ref=e1197]:\n                - img \"端午龙舟\" [ref=e1198]\n                - generic [ref=e1200]: 民俗活动\n                - generic [ref=e1201]:\n                  - heading \"端午龙舟\" [level=3] [ref=e1202]\n                  - paragraph [ref=e1203]: Dragon Boat Racing\n              - generic [ref=e1204]:\n                - generic [ref=e1205]:\n                  - img [ref=e1206]\n                  - generic [ref=e1209]: 广东 · 楚地遗风\n                - paragraph [ref=e1210]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e1211] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e1212]\n            - generic [ref=e1214]:\n              - generic [ref=e1215]:\n                - img \"剪纸\" [ref=e1216]\n                - generic [ref=e1218]: 传统美术\n                - generic [ref=e1219]:\n                  - heading \"剪纸\" [level=3] [ref=e1220]\n                  - paragraph [ref=e1221]: Paper Cutting\n              - generic [ref=e1222]:\n                - generic [ref=e1223]:\n                  - img [ref=e1224]\n                  - generic [ref=e1227]: 陕西 · 黄土高原\n                - paragraph [ref=e1228]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e1229] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e1230]\n            - generic [ref=e1232]:\n              - generic [ref=e1233]:\n                - img \"书法\" [ref=e1234]\n                - generic [ref=e1236]: 传统美术\n                - generic [ref=e1237]:\n                  - heading \"书法\" [level=3] [ref=e1238]\n                  - paragraph [ref=e1239]: Chinese Calligraphy\n              - generic [ref=e1240]:\n                - generic [ref=e1241]:\n                  - img [ref=e1242]\n                  - generic [ref=e1245]: 安徽 · 神州墨韵\n                - paragraph [ref=e1246]: 书法是中国特有的艺术形式，以毛笔书写汉字，融合了文字、绘画与哲学的精髓。\n                - link \"了解详情\" [ref=e1247] [cursor=pointer]:\n                  - /url: /heritage/chinese-calligraphy\n                  - text: 了解详情\n                  - img [ref=e1248]\n            - generic [ref=e1250]:\n              - generic [ref=e1251]:\n                - img \"京剧\" [ref=e1252]\n                - generic [ref=e1254]: 传统表演\n                - generic [ref=e1255]:\n                  - heading \"京剧\" [level=3] [ref=e1256]\n                  - paragraph [ref=e1257]: Peking Opera\n              - generic [ref=e1258]:\n                - generic [ref=e1259]:\n                  - img [ref=e1260]\n                  - generic [ref=e1263]: 北京 · 京城古韵\n                - paragraph [ref=e1264]: 京剧是中国影响最大的戏曲剧种，被誉为\"国粹\"，以唱念做打的表演方式闻名于世。\n                - link \"了解详情\" [ref=e1265] [cursor=pointer]:\n                  - /url: /heritage/peking-opera\n                  - text: 了解详情\n                  - img [ref=e1266]\n    - contentinfo [ref=e1268]:\n      - generic [ref=e1269]:\n        - generic [ref=e1270]:\n          - generic [ref=e1271]:\n            - generic [ref=e1272]:\n              - generic [ref=e1274]: 遗\n              - heading \"华夏非遗\" [level=3] [ref=e1276]\n            - paragraph [ref=e1277]: 致力于保护和传承中国非物质文化遗产，让千年文化在数字时代焕发新的生机。\n          - generic [ref=e1278]:\n            - heading \"探索分类\" [level=4] [ref=e1279]\n            - list [ref=e1280]:\n              - listitem [ref=e1281]:\n                - link \"传统工艺\" [ref=e1282] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e1283]:\n                - link \"传统表演\" [ref=e1284] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e1285]:\n                - link \"民俗活动\" [ref=e1286] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e1287]:\n                - link \"传统美术\" [ref=e1288] [cursor=pointer]:\n                  - /url: \"#categories\"\n          - generic [ref=e1