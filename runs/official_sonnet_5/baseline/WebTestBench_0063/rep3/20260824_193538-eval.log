          - generic [ref=e78]: 民俗活动\n                - generic [ref=e79]:\n                  - heading \"春节\" [level=3] [ref=e80]\n                  - paragraph [ref=e81]: Spring Festival\n              - generic [ref=e82]:\n                - generic [ref=e83]:\n                  - img [ref=e84]\n                  - generic [ref=e87]: 北京 · 华夏大地\n                - paragraph [ref=e88]: 春节是中国最重要的传统节日，承载着团圆、祈福、辞旧迎新等丰富的文化内涵。\n                - link \"了解详情\" [ref=e89] [cursor=pointer]:\n                  - /url: /heritage/spring-festival\n                  - text: 了解详情\n                  - img [ref=e90]\n            - generic [ref=e92]:\n              - generic [ref=e93]:\n                - img \"端午龙舟\" [ref=e94]\n                - generic [ref=e96]: 民俗活动\n                - generic [ref=e97]:\n                  - heading \"端午龙舟\" [level=3] [ref=e98]\n                  - paragraph [ref=e99]: Dragon Boat Racing\n              - generic [ref=e100]:\n                - generic [ref=e101]:\n                  - img [ref=e102]\n                  - generic [ref=e105]: 广东 · 楚地遗风\n                - paragraph [ref=e106]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e107] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e108]\n            - generic [ref=e110]:\n              - generic [ref=e111]:\n                - img \"剪纸\" [ref=e112]\n                - generic [ref=e114]: 传统美术\n                - generic [ref=e115]:\n                  - heading \"剪纸\" [level=3] [ref=e116]\n                  - paragraph [ref=e117]: Paper Cutting\n              - generic [ref=e118]:\n                - generic [ref=e119]:\n                  - img [ref=e120]\n                  - generic [ref=e123]: 陕西 · 黄土高原\n                - paragraph [ref=e124]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e125] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e126]\n            - generic [ref=e128]:\n              - generic [ref=e129]:\n                - img \"京剧\" [ref=e130]\n                - generic [ref=e132]: 传统表演\n                - generic [ref=e133]:\n                  - heading \"京剧\" [level=3] [ref=e134]\n                  - paragraph [ref=e135]: Peking Opera\n              - generic [ref=e136]:\n                - generic [ref=e137]:\n                  - img [ref=e138]\n                  - generic [ref=e141]: 北京 · 京城古韵\n                - paragraph [ref=e142]: 京剧是中国影响最大的戏曲剧种，被誉为\"国粹\"，以唱念做打的表演方式闻名于世。\n                - link \"了解详情\" [ref=e143] [cursor=pointer]:\n                  - /url: /heritage/peking-opera\n                  - text: 了解详情\n                  - img [ref=e144]\n            - generic [ref=e146]:\n              - generic [ref=e147]:\n                - img \"昆曲\" [ref=e148]\n                - generic [ref=e150]: 传统表演\n                - generic [ref=e151]:\n                  - heading \"昆曲\" [level=3] [ref=e152]\n                  - paragraph [ref=e153]: Kunqu Opera\n              - generic [ref=e154]:\n                - generic [ref=e155]:\n                  - img [ref=e156]\n                  - generic [ref=e159]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e160]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e161] [cursor=pointer]:\n                  - /url: /heritage/kunqu-opera\n                  - text: 了解详情\n                  - img [ref=e162]\n            - generic [ref=e164]:\n              - generic [ref=e165]:\n                - img \"书法\" [ref=e166]\n                - generic [ref=e168]: 传统美术\n                - generic [ref=e169]:\n                  - heading \"书法\" [level=3] [ref=e170]\n                  - paragraph [ref=e171]: Chinese Calligraphy\n              - generic [ref=e172]:\n                - generic [ref=e173]:\n                  - img [ref=e174]\n                  - generic [ref=e