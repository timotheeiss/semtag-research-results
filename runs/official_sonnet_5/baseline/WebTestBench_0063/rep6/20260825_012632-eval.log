- combobox [ref=e456] [cursor=pointer]:\n              - generic: 按名称\n              - img [ref=e457]\n          - paragraph [ref=e459]: 共 8 个非遗项目\n          - generic [ref=e460]:\n            - generic [ref=e461]:\n              - generic [ref=e462]:\n                - img \"春节\" [ref=e463]\n                - generic [ref=e465]: 民俗活动\n                - generic [ref=e466]:\n                  - heading \"春节\" [level=3] [ref=e467]\n                  - paragraph [ref=e468]: Spring Festival\n              - generic [ref=e469]:\n                - generic [ref=e470]:\n                  - img [ref=e471]\n                  - generic [ref=e474]: 北京 · 华夏大地\n                - paragraph [ref=e475]: 春节是中国最重要的传统节日，承载着团圆、祈福、辞旧迎新等丰富的文化内涵。\n                - link \"了解详情\" [ref=e476] [cursor=pointer]:\n                  - /url: /heritage/spring-festival\n                  - text: 了解详情\n                  - img [ref=e477]\n            - generic [ref=e479]:\n              - generic [ref=e480]:\n                - img \"端午龙舟\" [ref=e481]\n                - generic [ref=e483]: 民俗活动\n                - generic [ref=e484]:\n                  - heading \"端午龙舟\" [level=3] [ref=e485]\n                  - paragraph [ref=e486]: Dragon Boat Racing\n              - generic [ref=e487]:\n                - generic [ref=e488]:\n                  - img [ref=e489]\n                  - generic [ref=e492]: 广东 · 楚地遗风\n                - paragraph [ref=e493]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e494] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e495]\n            - generic [ref=e497]:\n              - generic [ref=e498]:\n                - img \"剪纸\" [ref=e499]\n                - generic [ref=e501]: 传统美术\n                - generic [ref=e502]:\n                  - heading \"剪纸\" [level=3] [ref=e503]\n                  - paragraph [ref=e504]: Paper Cutting\n              - generic [ref=e505]:\n                - generic [ref=e506]:\n                  - img [ref=e507]\n                  - generic [ref=e510]: 陕西 · 黄土高原\n                - paragraph [ref=e511]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e512] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e513]\n            - generic [ref=e515]:\n              - generic [ref=e516]:\n                - img \"京剧\" [ref=e517]\n                - generic [ref=e519]: 传统表演\n                - generic [ref=e520]:\n                  - heading \"京剧\" [level=3] [ref=e521]\n                  - paragraph [ref=e522]: Peking Opera\n              - generic [ref=e523]:\n                - generic [ref=e524]:\n                  - img [ref=e525]\n                  - generic [ref=e528]: 北京 · 京城古韵\n                - paragraph [ref=e529]: 京剧是中国影响最大的戏曲剧种，被誉为\"国粹\"，以唱念做打的表演方式闻名于世。\n                - link \"了解详情\" [ref=e530] [cursor=pointer]:\n                  - /url: /heritage/peking-opera\n                  - text: 了解详情\n                  - img [ref=e531]\n            - generic [ref=e533]:\n              - generic [ref=e534]:\n                - img \"昆曲\" [ref=e535]\n                - generic [ref=e537]: 传统表演\n                - generic [ref=e538]:\n                  - heading \"昆曲\" [level=3] [ref=e539]\n                  - paragraph [ref=e540]: Kunqu Opera\n              - generic [ref=e541]:\n                - generic [ref=e542]:\n                  - img [ref=e543]\n                  - generic [ref=e546]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e547]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e548] [cursor=pointer]:\n                  - /url: /heritage/kunqu-opera\n                  - text: 了解详情\n                  - img [ref=e549]\n            - generic [ref=e551]:\n              - generic [ref=e552]:\n                - img \"书法\" [ref=e553]\n                - generic [ref=e555]: 传统美术\n                - generic [ref=e556]:\n                  - heading \"书法\" [level=3] [ref=e557]\n                  - paragraph [ref=e558]: Chinese Calligraphy\n              - generic [ref=e559]:\n                - generic [ref=e560]:\n                  - img [ref=e561]\n                  - generic [ref=e564]: 安徽 · 神州墨韵\n                - paragraph [ref=e565]: 书法是中国特有的艺术形式，以毛笔书写汉字，融合了文字、绘画与哲学的精髓。\n                - link \"了解详情\" [ref=e566] [cursor=pointer]:\n                  - /url: /heritage/chinese-calligraphy\n                  - text: 了解详情\n                  - img [ref=e567]\n            - generic [ref=e569]:\n              - generic [ref=e570]:\n                - img \"苏绣\" [ref=e571]\n                - generic [ref=e573]: 传统工艺\n                - generic [ref=e574]:\n                  - heading \"苏绣\" [level=3] [ref=e575]\n                  - paragraph [ref=e576]: Suzhou Embroidery\n              - generic [ref=e577]:\n                - generic [ref=e578]:\n                  - img [ref=e579]\n                  - generic [ref=e582]: 江苏 · 江南水乡\n                - paragraph [ref=e583]: 苏绣是中国四大名绣之一，以精细雅洁著称，图案秀丽、针法活泼、色彩清雅。\n                - link \"了解详情\" [ref=e584] [cursor=pointer]:\n                  - /url: /heritage/suzhou-embroidery\n                  - text: 了解详情\n                  - img [ref=e585]\n            - generic [ref=e587]:\n              - generic [ref=e588]:\n                - img \"宜兴紫砂\" [ref=e589]\n                - generic [ref=e591]: 传统工艺\n                - generic [ref=e592]:\n                  - heading \"宜兴紫砂\" [level=3] [ref=e593]\n                  - paragraph [ref=e594]: Yixing Purple Clay\n              - generic [ref=e595]:\n                - generic [ref=e596]:\n                  - img [ref=e597]\n                  - generic [ref=e600]: 江苏 · 太湖之滨\n                - paragraph [ref=e601]: 宜兴紫砂壶以独特的紫砂泥料制成，造型古朴典雅，是中国传统茶文化的重要载体。\n                - link \"了解详情\" [ref=e602] [cursor=pointer]:\n                  - /url: /heritage/yixing-teapot\n                  - text: 了解详情\n                  - img [ref=e603]\n    - contentinfo [ref=e605]:\n      - generic [ref=e606]:\n        - generic [ref=e607]:\n          - generic [ref=e608]:\n            - generic [ref=e609]:\n              - generic [ref=e611]: 遗\n              - heading \"华夏非遗\" [level=3] [ref=e613]\n            - paragraph [ref=e614]: 致力于保护和传承中国非物质文化遗产，让千年文化在数字时代焕发新的生机。\n          - generic [ref=e615]:\n            - heading \"探索分类\" [level=4] [ref=e616]\n            - list [ref=e617]:\n              - listitem [ref=e618]:\n                - link \"传统工艺\" [ref=e619] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e620]:\n                - link \"传统表演\" [ref=e621] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e622]:\n                - link \"民俗活动\" [ref=e623] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e624]:\n                - link \"传统美术\" [ref=e625] [cursor=pointer]:\n                  - /url: \"#categories\"\n          - generic [ref=e626]:\n            - heading \"了解更多\" [level=4] [ref=e627]\n            - list [ref=e628]:\n              - listitem [ref=e629]:\n                - link \"关于我们\" [ref=e630] [cursor=pointer]:\n                  - /url: \"#\"\n              - listitem [ref=e631]:\n                - link \"使用指南\" [ref=e632] [cursor=pointer]:\n                  - /url: \"#\"\n              - listitem [ref=e633]:\n                - link \"联系方式\" [ref=e634] [cursor=pointer]:\n                  - /url: \"#\"\n              - listitem [ref=e635]:\n                - link \"版权声明\" [ref=e636] [cursor=pointer]:\n                  - /url: \"#\"\n        - paragraph [ref=e638]: © 2024 华夏非遗. 保护传承，让文化永续流传。\n```"
