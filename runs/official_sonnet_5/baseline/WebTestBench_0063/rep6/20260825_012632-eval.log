aph [ref=e99]: Dragon Boat Racing\n              - generic [ref=e100]:\n                - generic [ref=e101]:\n                  - img [ref=e102]\n                  - generic [ref=e105]: 广东 · 楚地遗风\n                - paragraph [ref=e106]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e107] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e108]\n            - generic [ref=e110]:\n              - generic [ref=e111]:\n                - img \"剪纸\" [ref=e112]\n                - generic [ref=e114]: 传统美术\n                - generic [ref=e115]:\n                  - heading \"剪纸\" [level=3] [ref=e116]\n                  - paragraph [ref=e117]: Paper Cutting\n              - generic [ref=e118]:\n                - generic [ref=e119]:\n                  - img [ref=e120]\n                  - generic [ref=e123]: 陕西 · 黄土高原\n                - paragraph [ref=e124]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e125] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e126]\n            - generic [ref=e128]:\n              - generic [ref=e129]:\n                - img \"京剧\" [ref=e130]\n                - generic [ref=e132]: 传统表演\n                - generic [ref=e133]:\n                  - heading \"京剧\" [level=3] [ref=e134]\n                  - paragraph [ref=e135]: Peking Opera\n              - generic [ref=e136]:\n                - generic [ref=e137]:\n                  - img [ref=e138]\n                  - generic [ref=e141]: 北京 · 京城古韵\n                - paragraph [ref=e142]: 京剧是中国影响最大的戏曲剧种，被誉为\"国粹\"，以唱念做打的表演方式闻名于世。\n                - link \"了解详情\" [ref=e143] [cursor=pointer]:\n                  - /url: /heritage/peking-opera\n                  - text: 了解详情\n                  - img [ref=e144]\n            - generic [ref=e146]:\n              - generic [ref=e147]:\n                - img \"昆曲\" [ref=e148]\n                - generic [ref=e150]: 传统表演\n                - generic [ref=e151]:\n                  - heading \"昆曲\" [level=3] [ref=e152]\n                  - paragraph [ref=e153]: Kunqu Opera\n              - generic [ref=e154]:\n                - generic [ref=e155]:\n                  - img [ref=e156]\n                  - generic [ref=e159]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e160]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e161] [cursor=pointer]:\n                  - /url: /heritage/kunqu-opera\n                  - text: 了解详情\n                  - img [ref=e162]\n            - generic [ref=e164]:\n              - generic [ref=e165]:\n                - img \"书法\" [ref=e166]\n                - generic [ref=e168]: 传统美术\n                - generic [ref=e169]:\n                  - heading \"书法\" [level=3] [ref=e170]\n                  - paragraph [ref=e171]: Chinese Calligraphy\n              - generic [ref=e172]:\n                - generic [ref=e173]:\n                  - img [ref=e174]\n                  - generic [ref=e177]: 安徽 · 神州墨韵\n                - paragraph [ref=e178]: 书法是中国特有的艺术形式，以毛笔书写汉字，融合了文字、绘画与哲学的精髓。\n                - link \"了解详情\" [ref=e179] [cursor=pointer]:\n                  - /url: /heritage/chinese-calligraphy\n                  - text: 了解详情\n                  - img [ref=e180]\n            - generic [ref=e182]:\n              - generic [ref=e183]:\n                - img \"苏绣\" [ref=e184]\n                - generic [ref=e186]: 传统工艺\n                - generic [ref=e187]:\n                  - heading \"苏绣\" [level=3] [ref=e188]\n                  - paragraph [ref=e189]: Suzhou Embroidery\n              - generic [ref=e190]:\n                - generic [ref=e191]:\n                  - img [ref=e192]\n                  - generic [ref=e195]: 江苏 · 江南水乡\n                - paragraph [ref=e196]: 苏绣是中国四大名绣之一，以精细雅洁著称，图案秀丽、针法活泼、色彩清雅。\n                - link \"了解详情\" [ref=e197] [cursor=pointer]:\n                  - /url: /heritage/suzhou-embroidery\n                  - text: 了解详情\n                  - img [ref=e198]\n            - generic [ref=e200]:\n              - generic [ref=e201]:\n                - img \"宜兴紫砂\" [ref=e202]\n                - generic [ref=e204]: 传统工艺\n                - generic [ref=e205]:\n                  - heading \"宜兴紫砂\" [level=3] [ref=e206]\n                  - paragraph [ref=e207]: Yixing Purple Clay\n              - generic [ref=e208]:\n                - generic [ref=e209]:\n                  - img [ref=e210]\n                  - generic [ref=e213]: 江苏 · 太湖之滨\n                - paragraph [ref=e214]: 宜兴紫砂壶以独特的紫砂泥料制成，造型古朴典雅，是中国传统茶文化的重要载体。\n                - link \"了解详情\" [ref=e215] [cursor=pointer]:\n                  - /url: /heritage/yixing-teapot\n                  - text: 了解详情\n                  - img [ref=e216]\n    - contentinfo [ref=e218]:\n      - generic [ref=e219]:\n        - generic [ref=e220]:\n          - generic [ref=e221]:\n            - generic [ref=e222]:\n              - generic [ref=e224]: 遗\n              - heading \"华夏非遗\" [level=3] [ref=e226]\n            - paragraph [ref=e227]: 致力于保护和传承中国非物质文化遗产，让千年文化在数字时代焕发新的生机。\n          - generic [ref=e228]:\n            - heading \"探索分类\" [level=4] [ref=e229]\n            - list [ref=e230]:\n              - listitem [ref=e231]:\n                - link \"传统工艺\" [ref=e232] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e233]:\n                - link \"传统表演\" [ref=e234] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e235]:\n                - link \"民俗活动\" [ref=e236] [cursor=pointer]:\n                  - /url: \"#categories\"\n              - listitem [ref=e237]:\n                - link \"传统美术\" [ref=e238] [cursor=pointer]:\n                  - /url: \"#categories\"\n          - generic [ref=e239]:\n            - heading \"了解更多\" [level=4] [ref=e240]\n            - list