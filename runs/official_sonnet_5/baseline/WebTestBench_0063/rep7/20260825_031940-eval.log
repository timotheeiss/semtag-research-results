mg [ref=e479]\n            - generic [ref=e481]:\n              - generic [ref=e482]:\n                - img \"端午龙舟\" [ref=e483]\n                - generic [ref=e485]: 民俗活动\n                - generic [ref=e486]:\n                  - heading \"端午龙舟\" [level=3] [ref=e487]\n                  - paragraph [ref=e488]: Dragon Boat Racing\n              - generic [ref=e489]:\n                - generic [ref=e490]:\n                  - img [ref=e491]\n                  - generic [ref=e494]: 广东 · 楚地遗风\n                - paragraph [ref=e495]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e496] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e497]\n            - generic [ref=e499]:\n              - generic [ref=e500]:\n                - img \"剪纸\" [ref=e501]\n                - generic [ref=e503]: 传统美术\n                - generic [ref=e504]:\n                  - heading \"剪纸\" [level=3] [ref=e505]\n                  - paragraph [ref=e506]: Paper Cutting\n              - generic [ref=e507]:\n                - generic [ref=e508]:\n                  - img [ref=e509]\n                  - generic [ref=e512]: 陕西 · 黄土高原\n                - paragraph [ref=e513]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e514] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e515]\n            - generic [ref=e517]:\n              - generic [ref=e518]:\n                - img \"京剧\" [ref=e519]\n                - generic [ref=e521]: 传统表演\n                - generic [ref=e522]:\n                  - heading \"京剧\" [level=3] [ref=e523]\n                  - paragraph [ref=e524]: Peking Opera\n              - generic [ref=e525]:\n                - generic [ref=e526]:\n                  - img [ref=e527]\n                  - generic [ref=e530]: 北京 · 京城古韵\n                - paragraph [ref=e531]: