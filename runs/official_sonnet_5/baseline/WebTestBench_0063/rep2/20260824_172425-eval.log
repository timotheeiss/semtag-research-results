      - combobox [ref=e490] [cursor=pointer]:\n              - generic: 全部类别\n              - img [ref=e491]\n            - combobox [ref=e493] [cursor=pointer]:\n              - generic: 全部地区\n              - img [ref=e494]\n            - combobox [ref=e496] [cursor=pointer]:\n              - generic: 按名称\n              - img [ref=e497]\n          - paragraph [ref=e499]: 共 8 个非遗项目\n          - generic [ref=e500]:\n            - generic [ref=e501]:\n              - generic [ref=e502]:\n                - img \"春节\" [ref=e503]\n                - generic [ref=e505]: 民俗活动\n                - generic [ref=e506]:\n                  - heading \"春节\" [level=3] [ref=e507]\n                  - paragraph [ref=e508]: Spring Festival\n              - generic [ref=e509]:\n                - generic [ref=e510]:\n                  - img [ref=e511]\n                  - generic [ref=e514]: 北京 · 华夏大地\n                - paragraph [ref=e515]: 春节是中国最重要的传统节日，承载着团圆、祈福、辞旧迎新等丰富的文化内涵。\n                - link \"了解详情\" [ref=e516] [cursor=pointer]:\n                  - /url: /heritage/spring-festival\n                  - text: 了解详情\n                  - img [ref=e517]\n            - generic [ref=e519]:\n              - generic [ref=e520]:\n                - img \"端午龙舟\" [ref=e521]\n                - generic [ref=e523]: 民俗活动\n                - generic [ref=e524]:\n                  - heading \"端午龙舟\" [level=3] [ref=e525]\n                  - paragraph [ref=e526]: Dragon Boat Racing\n              - generic [ref=e527]:\n                - generic [ref=e528]:\n                  - img [ref=e529]\n                  - generic [ref=e532]: 广东 · 楚地遗风\n                - paragraph [ref=e533]: 龙舟竞渡是端午节最具代表性的民俗活动，承载着对屈原的纪念和对美好生活的祈愿。\n                - link \"了解详情\" [ref=e534] [cursor=pointer]:\n                  - /url: /heritage/dragon-boat\n                  - text: 了解详情\n                  - img [ref=e535]\n            - generic [ref=e537]:\n              - generic [ref=e538]:\n                - img \"剪纸\" [ref=e539]\n                - generic [ref=e541]: 传统美术\n                - generic [ref=e542]:\n                  - heading \"剪纸\" [level=3] [ref=e543]\n                  - paragraph [ref=e544]: Paper Cutting\n              - generic [ref=e545]:\n                - generic [ref=e546]:\n                  - img [ref=e547]\n                  - generic [ref=e550]: 陕西 · 黄土高原\n                - paragraph [ref=e551]: 剪纸是中国最古老的民间艺术之一，用剪刀或刻刀在纸上剪刻花纹，寓意吉祥美好。\n                - link \"了解详情\" [ref=e552] [cursor=pointer]:\n                  - /url: /heritage/paper-cutting\n                  - text: 了解详情\n                  - img [ref=e553]\n            - generic [ref=e555]:\n              - generic [ref=e556]:\n                - img \"京剧\" [ref=e557]\n                - generic [ref=e559]: 传统表演\n                - generic [ref=e560]:\n                  - heading \"京剧\" [level=3] [ref=e561]\n                  - paragraph [ref=e562]: Peking Opera\n              - generic [ref=e563]:\n                - generic [ref=e564]:\n                  - img [ref=e565]\n                  - generic [ref=e568]: 北京 · 京城古韵\n                - paragraph [ref=e569]: 京剧是中国影响最大的戏曲剧种，被誉为\"国粹\"，以唱念做打的表演方式闻名于世。\n                - link \"了解详情\" [ref=e570] [cursor=pointer]:\n                  - /url: /heritage/peking-opera\n                  - text: 了解详情\n                  - img [ref=e571]\n            - generic [ref=e573]:\n              - generic [ref=e574]:\n                - img \"昆曲\" [ref=e575]\n                - generic [ref=e577]: 传统表演\n                - generic [ref=e578]:\n                  - heading \"昆曲\" [level=3] [ref=e579]\n                  - paragraph [ref=e580]: Kunqu Opera\n              - generic [ref=e581]:\n                - generic [ref=e582]:\n                  - img [ref=e583]\n                  - generic [ref=e586]: 江苏 · 姑苏雅韵\n                - paragraph [ref=e587]: 昆曲是中国最古老的戏曲剧种之一，被誉为\"百戏之祖\"，以典雅细腻的表演著称。\n                - link \"了解详情\" [ref=e588] [cursor=pointer]:\n                  - /ur